FROM python:3.10.16-slim-bullseye
WORKDIR /app
# CPU-only PyTorch first, so the requirements below don't pull the CUDA build
RUN pip install --no-cache-dir --default-timeout=1000 --retries=5 --extra-index-url https://download.pytorch.org/whl/cpu torch==2.5.1+cpu
COPY requirements.txt .
RUN pip install --no-cache-dir --default-timeout=1000 --retries=5 -r requirements.txt
COPY . .
CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8001"]