# Embeddings and vector store
EMBEDDING_MODEL=intfloat/multilingual-e5-base
QDRANT_HOST=qdrant
QDRANT_PORT=6333
COLLECTION_NAME=cnil_docs

# Local LLM through Ollama, running on your machine (not in Docker).
# host.docker.internal points to your machine from inside the containers.
OLLAMA_URL=http://host.docker.internal:11434
# Any model you have pulled with `ollama pull`, e.g. llama3.1:8b
OLLAMA_MODEL=llama3.1:8b

# Evaluation (runs outside Docker, so it uses localhost)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_JUDGE_MODEL=llama3.1:8b
